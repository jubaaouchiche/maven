
pipeline {
    agent any
    environment{
        SONARQUBE_SERVER= 'sonar-server'
        //SCANNER_HOME= tool 'sonar-scanner'
        BUILD_NUMBER= "${env.BUILD_NUMBER}"
        MAVEN_IMAGE = "arezkiguezout/myapp-base-devsecops"
    }

    stages{
        stage('Clone'){
            steps{
                checkout scm
            }
        }
        stage('Analyse Sonarqube'){
            environment {
                SCANNER_HOME = tool 'sonar-scanner'
            }
            steps{
                withSonarQubeEnv("${SONARQUBE_SERVER}"){
                    sh """
                    ${SCANNER_HOME}/bin/sonar-scanner \
                    -Dsonar.projectKey=maven-demo \
                    -Dsonar.projectName=maven-demo \
                    -Dsonar.sources=.
                    """
                }
            }
        }
        stage('Quality Gate'){
            steps{
                timeout(time: 5, unit:'MINUTES'){
                    waitForQualityGate abortPipeline:false
                }   
            }
        }

        stage('Trivy File Scan'){
            steps{
                echo "Trivy File Scan"
                sh 'trivy fs . > rapportfs.txt'
            }
        }

        stage('Build Image Docker'){
            steps{
                script{
                    docker.build("${env.MAVEN_IMAGE}:${BUILD_NUMBER}", '.') 
                }
            }
        }

        stage('Trivy Image Scan'){
            environment{
                TMPDIR = "/var/tmp"
            }
            steps{
                sh "trivy image --scanners vuln ${env.MAVEN_IMAGE}:${BUILD_NUMBER} > rapportimage.txt || true"
            }
        }

        stage('Docker Push'){
            steps{
                script{
                    withDockerRegistry(credentialsId: 'docker_id', url: 'https://index.docker.io/v1/'){
                        //docker.image("${env.MAVEN_IMAGE}").push(latest)
                        sh "docker push ${env.MAVEN_IMAGE}:${BUILD_NUMBER}"
                    }
                }
            }
        }

        stage('push new code to gitlab'){
            environment{
                GIT_REPO_NAME='myapp_j2e_learning'
                GIT_USER_NAME='arezkiguezout'
            }
            steps{
                dir('manifests-devsecops'){
                    withCredentials([string(credentialsId:'GitLab', variable: 'gitlab')]){
                        sh """
                        git config user.name "arezki"
                        git config user.email "arezki@test.com"
                        imageTag=\$(grep -oP '(?<=arezkiguezout/myapp-base-devsecops:)[^ ]+' deploy.yaml)
                        echo \$imageTag
                        echo ${MAVEN_IMAGE}:\$imageTag
                        sed -i "s|arezkiguezout/myapp-base-devsecops:\$imageTag|arezkiguezout/myapp-base-devsecops:${BUILD_NUMBER}|" deploy.yaml
                        git add deploy.yaml
                        git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                        git push https://${GIT_USER_NAME}:\$gitlab@repo-dev.efi-academy.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:master
                        """
                    }
                }
            }
        }
    }
}